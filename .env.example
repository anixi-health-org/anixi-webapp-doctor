# Local development defaults (copy to .env)
REACT_APP_ANIXI_API_URL=http://127.0.0.1:8000
REACT_APP_MASTRA_BASE_URL=http://127.0.0.1:4111
REACT_APP_AYAH_USE_CLOUD_ONLY=false

# Local seed doctor (npm run seed:doctors) — never use production passwords
# REACT_APP_SEED_DOCTOR_EMAIL=doctor@test.com
# REACT_APP_SEED_DOCTOR_PASSWORD=change-me-local-only

# Production — copy .env.production.example to .env.production or set in Vercel
# REACT_APP_ANIXI_API_URL=https://api.anixihealth.com
# REACT_APP_AYAH_USE_CLOUD_ONLY=true
