rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

  function isBootstrapAdmin() {
    return isSignedIn() && uid() in [
      'Xwf3BwiJRJb6eL87p8LyL4Syyku1'
    ];
  }

  function isAdmin() {
    return isSignedIn() && (
      isBootstrapAdmin() ||
      (
        exists(/databases/$(database)/documents/admins/$(uid())) &&
        get(/databases/$(database)/documents/admins/$(uid())).data.active == true
      )
    );
  }

    // Patient approved doctor (mobile app flow)
    function isApprovedDoctorForPatient(patientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(patientId)/approved_doctors/$(uid()))
        && get(/databases/$(database)/documents/Users/$(patientId)/approved_doctors/$(uid())).data.status == 'active';
    }

    // Doctor added patient manually (doctor portal flow)
    function isDoctorWithApprovedPatient(patientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(uid())/approved_patients/$(patientId));
    }

    function isApprovedShareDoctorForPatient(patientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(patientId)/approved_shares/$(uid()));
    }

    function canDoctorReadPatientHealthData(patientId) {
      return isApprovedDoctorForPatient(patientId)
        || isDoctorWithApprovedPatient(patientId)
        || isApprovedShareDoctorForPatient(patientId);
    }

    function isLinkedCaregiverForPatient(patientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(uid())/linked_patients/$(patientId))
        && get(/databases/$(database)/documents/Users/$(uid())/linked_patients/$(patientId)).data.status != 'inactive';
    }

    function isNominatedCaregiverEmail() {
      return isSignedIn()
        && resource.data.hasCaregiver == true
        && resource.data.caregiverEmail == request.auth.token.email;
    }

    function canReadPatientHealthData(patientId) {
      return canDoctorReadPatientHealthData(patientId) || isLinkedCaregiverForPatient(patientId);
    }

    function isPracticeOwner(practiceId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/practices/$(practiceId)).data.ownerId == uid();
    }

    // Fetch the caller's membership document for a practice
    function getMember(practiceId) {
      return get(/databases/$(database)/documents/practices/$(practiceId)/members/$(uid())).data;
    }

    function isMember(practiceId) {
      return exists(/databases/$(database)/documents/practices/$(practiceId)/members/$(uid()))
        && getMember(practiceId).status == 'active';
    }

    function isOwner(practiceId) {
      return isMember(practiceId) && (
        getMember(practiceId).role == 'owner' ||
        getMember(practiceId).role == 'practice_manager'
      );
    }

    function hasPerm(practiceId, perm) {
      return isMember(practiceId) && getMember(practiceId).permissions[perm] == true;
    }

    function canManagePracticePatients(practiceId) {
      return isMember(practiceId) && (
        hasPerm(practiceId, 'managePatients') ||
        getMember(practiceId).role == 'owner' ||
        getMember(practiceId).role == 'practice_manager' ||
        getMember(practiceId).role == 'doctor' ||
        getMember(practiceId).role == 'receptionist'
      );
    }

    // ─── Legacy collections (unchanged for mobile compatibility) ────────────────

    match /Users/{userId}/adherence_records/{recordId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/mood_entries/{entryId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/vitals_records/{recordId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/medications/{medId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/mood_records/{recordId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/healthRecords/{recordId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/heathSummary/{summaryId} {
      allow read: if isSignedIn() && (uid() == userId || canReadPatientHealthData(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    // Doctor portal: link patient to doctor (mirrors approved_patients on doctor doc)
    match /Users/{patientId}/approved_doctors/{doctorId} {
      allow read: if isSignedIn() && (uid() == patientId || uid() == doctorId);
      allow create, update: if isSignedIn()
        && uid() == doctorId
        && exists(/databases/$(database)/documents/Users/$(doctorId)/approved_patients/$(patientId));
    }

    // Doctor can read/write their approved_patients list
    match /Users/{doctorId}/approved_patients/{patientId} {
      allow read, write: if isSignedIn() && uid() == doctorId;
    }

    // Caregiver portal: patients linked to a caregiver account
    match /Users/{caregiverId}/linked_patients/{patientId} {
      allow read, write: if isSignedIn() && uid() == caregiverId;
    }

    // ─── Sharing requests (mobile parity) ─────────────────────────────────────

    match /Users/{patientId}/sharing_requests/{requestId} {
      allow read: if isSignedIn() && uid() == patientId;
      allow create: if isSignedIn()
        && uid() == patientId
        && request.resource.data.status == 'pending'
        && request.resource.data.doctorId is string;
      allow update: if isSignedIn() && (
        uid() == patientId ||
        resource.data.doctorId == uid()
      );
    }

    match /Users/{doctorId}/incoming_sharing_requests/{requestId} {
      allow read: if isSignedIn() && uid() == doctorId;
      allow create: if isSignedIn()
        && request.resource.data.patientId == uid()
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && uid() == doctorId;
    }

    match /Users/{patientId}/approved_shares/{doctorId} {
      allow read: if isSignedIn() && (uid() == patientId || uid() == doctorId);
      allow create, update: if isSignedIn() && uid() == doctorId;
    }

    match /Users/{doctorId}/practice_permissions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == doctorId;
      allow update: if isSignedIn() && (
        uid() == doctorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delegates'])
      );
    }

    match /Users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() &&
        (resource.data.doctorId == uid() || resource.data.patientId == uid());
      allow create: if isSignedIn() && request.resource.data.doctorId == uid();
      allow update: if isSignedIn() &&
        (resource.data.doctorId == uid() || resource.data.patientId == uid());
    }

    // ─── Invoices (doctor portal financial tracking) ───────────────────────────

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() &&
        (resource.data.doctorId == uid() || resource.data.patientId == uid());
      allow create: if isSignedIn()
        && request.resource.data.doctorId == uid()
        && request.resource.data.patientId is string
        && request.resource.data.appointmentId is string;
      allow update: if isSignedIn() && resource.data.doctorId == uid();
      allow delete: if isSignedIn() && resource.data.doctorId == uid();
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (uid() == doctorId || isAdmin());

      // Patient-readable availability (derived from practice clinic hours).
      // Patients must not read practices/.../bookableBlocks directly.
      match /settings/{settingsDocId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (uid() == doctorId || isAdmin());
      }
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (uid() == adminId || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isBootstrapAdmin() && uid() == adminId)
      );
      allow update, delete: if isAdmin();
    }

    match /group_posts/{postId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── Patients (manual creation by doctors) ─────────────────────────────────
    // Doctors may create manual patient records that are linked to them.
    // Patients themselves (mobile app) should use the legacy `Users/{uid}` docs.
    match /patients/{patientId} {
      allow create: if isSignedIn()
        && request.resource.data.isManual == true
        && (
          request.resource.data.assignedDoctorId == uid() ||
          (
            request.resource.data.practiceId is string &&
            canManagePracticePatients(request.resource.data.practiceId)
          )
        );
      // Approved doctors may read medical profile (blood group, weight, etc.) for tracking.
      // Doctors must not edit app-linked patient data — only the patient, or manual records.
      allow read: if isSignedIn() && (
        resource.data.assignedDoctorId == uid() ||
        uid() == patientId ||
        canDoctorReadPatientHealthData(patientId) ||
        isLinkedCaregiverForPatient(patientId) ||
        isNominatedCaregiverEmail() ||
        (
          resource.data.practiceId is string &&
          canManagePracticePatients(resource.data.practiceId)
        )
      );
      allow update: if isSignedIn() && (
        uid() == patientId ||
        (
          resource.data.isManual == true &&
          (
            resource.data.assignedDoctorId == uid() ||
            (
              resource.data.practiceId is string &&
              canManagePracticePatients(resource.data.practiceId)
            )
          )
        ) ||
        (
          isNominatedCaregiverEmail() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caregiverId', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn()
        && resource.data.isManual == true
        && (
          resource.data.assignedDoctorId == uid() ||
          (
            resource.data.practiceId is string &&
            canManagePracticePatients(resource.data.practiceId)
          )
        );
    }

    // ─── Referrals / invitations (doctor-owned) ────────────────────────────────
    // Used to generate a signup link and to log invitation attempts.
    match /referrals/{doctorId} {
      allow read, write: if isSignedIn() && uid() == doctorId;

      match /invitations/{invitationId} {
        allow read, write: if isSignedIn() && uid() == doctorId;
      }
    }

    // ─── Email queue (Firebase Extension: Trigger Email) ───────────────────────
    // Allow signed-in users to enqueue emails, but never read/update them.
    // This enables client-side email sends without Cloud Functions.
    match /mail/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] is string
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasAny(['html', 'text'])
        && request.resource.data.message.subject is string;
      allow read, update, delete: if false;
    }

    // Some projects configure Trigger Email to use `emails` instead of `mail`.
    match /emails/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] is string
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasAny(['html', 'text'])
        && request.resource.data.message.subject is string;
      allow read, update, delete: if false;
    }

    // ─── Practices ──────────────────────────────────────────────────────────────

    match /practices/{practiceId} {
      // Members and practice owners may read practice context
      allow read: if isSignedIn() && (isMember(practiceId) || isPracticeOwner(practiceId));
      // Only owners can create or update practice metadata
      allow create: if isSignedIn();   // owner auto-provisioned on first login
      allow update: if isSignedIn() && (isOwner(practiceId) || isPracticeOwner(practiceId));

      // ─── Members ──────────────────────────────────────────────────────────────

      match /members/{memberId} {
        // Members can read their own record; owners/managers can read all
        allow read: if isSignedIn() &&
          (uid() == memberId || isOwner(practiceId) || hasPerm(practiceId, 'manageMembers'));
        // Owner bootstrap + invited member self-activate + managers inviting
        allow create: if isSignedIn() && (
          isOwner(practiceId) ||
          hasPerm(practiceId, 'manageMembers') ||
          (
            uid() == memberId &&
            get(/databases/$(database)/documents/practices/$(practiceId)).data.ownerId == uid() &&
            request.resource.data.role == 'owner'
          ) ||
          (
            uid() == memberId &&
            request.resource.data.status == 'active'
          )
        );
        allow update: if isSignedIn() && (
          isOwner(practiceId) ||
          hasPerm(practiceId, 'manageMembers') ||
          (
            uid() == memberId &&
            get(/databases/$(database)/documents/practices/$(practiceId)).data.ownerId == uid()
          )
        );
        allow delete: if isSignedIn() && (isOwner(practiceId) || hasPerm(practiceId, 'manageMembers'));
      }

      match /invites/{inviteId} {
        // Invitees open the link before signing in; token is still required to accept
        allow read: if true;
        allow create, update: if isSignedIn() && (
          isOwner(practiceId) || hasPerm(practiceId, 'manageMembers') ||
          // Invitee may mark accepted after joining
          (request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedByUid == uid())
        );
        allow delete: if isSignedIn() && (isOwner(practiceId) || hasPerm(practiceId, 'manageMembers'));
      }

      // ─── Bookable Blocks ───────────────────────────────────────────────────────
      // Patients NEVER read bookable block documents directly.
      // Slot availability is served as derived AvailableSlot objects.

      match /bookableBlocks/{blockId} {
        allow read: if isSignedIn() && isMember(practiceId);
        allow create, update, delete: if isSignedIn() &&
          hasPerm(practiceId, 'manageAppointments');
      }

      // ─── Soft Blocks ───────────────────────────────────────────────────────────
      // Strictly doctor/practice only. Patients can NEVER access.

      match /softBlocks/{softBlockId} {
        allow read: if isSignedIn() &&
          isMember(practiceId) && hasPerm(practiceId, 'manageSoftBlocks');
        allow create, update: if isSignedIn() &&
          hasPerm(practiceId, 'manageSoftBlocks');
        allow delete: if isSignedIn() &&
          hasPerm(practiceId, 'manageSoftBlocks');
      }

      // ─── Practice Appointments ─────────────────────────────────────────────────

      match /appointments/{appointmentId} {
        allow read: if isSignedIn() &&
          (isMember(practiceId) ||
           resource.data.patientId == uid());

        allow create: if isSignedIn() &&
          hasPerm(practiceId, 'manageAppointments') &&
          // Patients cannot set overrideApplied = true
          (!request.resource.data.keys().hasAny(['overrideApplied']) ||
            request.resource.data.overrideApplied == false ||
            hasPerm(practiceId, 'overrideConflicts'));

        allow update: if isSignedIn() && (
          // Practice members with permission can update
          hasPerm(practiceId, 'manageAppointments') ||
          // Patients may only update their own appointment status (cancellation)
          (resource.data.patientId == uid() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
        ) && (
          // Only permissioned members may set overrideApplied = true
          !request.resource.data.keys().hasAny(['overrideApplied']) ||
          request.resource.data.overrideApplied == resource.data.overrideApplied ||
          hasPerm(practiceId, 'overrideConflicts')
        );
      }

      // ─── Booking Policy ────────────────────────────────────────────────────────

      match /config/bookingPolicy {
        allow read: if isSignedIn() && (isMember(practiceId) || isPracticeOwner(practiceId));
        allow write: if isSignedIn() && (
          hasPerm(practiceId, 'editBookingPolicies') ||
          isPracticeOwner(practiceId)
        );
      }

      // ─── Daily Schedule ────────────────────────────────────────────────────────

      match /dailySchedule/{dateId} {
        allow read: if isSignedIn() && isMember(practiceId);
        allow write: if isSignedIn() && isMember(practiceId);
      }
    }

    // ─── Patient ↔ Doctor messaging (shared with mobile) ───────────────────────

    function isConversationParticipant(participantIds) {
      return isSignedIn() && request.auth.uid in participantIds;
    }

    match /conversations/{conversationId} {
      allow read: if isConversationParticipant(resource.data.participantIds);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if isConversationParticipant(resource.data.participantIds)
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;
        allow update: if isSignedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.auth.uid in request.resource.data.readBy
          && request.resource.data.readBy.hasAll(resource.data.readBy);
        allow delete: if false;
      }
    }
  }
}
