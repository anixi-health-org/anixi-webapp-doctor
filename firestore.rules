rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isApprovedDoctorForPatient(patientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(patientId)/approved_doctors/$(uid()))
        && get(/databases/$(database)/documents/Users/$(patientId)/approved_doctors/$(uid())).data.status == 'active';
    }

    // Fetch the caller's membership document for a practice
    function getMember(practiceId) {
      return get(/databases/$(database)/documents/practices/$(practiceId)/members/$(uid())).data;
    }

    function isMember(practiceId) {
      return exists(/databases/$(database)/documents/practices/$(practiceId)/members/$(uid()))
        && getMember(practiceId).status == 'active';
    }

    function isOwner(practiceId) {
      return isMember(practiceId) && getMember(practiceId).role == 'owner';
    }

    function hasPerm(practiceId, perm) {
      return isMember(practiceId) && getMember(practiceId).permissions[perm] == true;
    }

    // ─── Legacy collections (unchanged for mobile compatibility) ────────────────

    match /Users/{userId}/adherence_records/{recordId} {
      allow read: if isSignedIn() && (uid() == userId || isApprovedDoctorForPatient(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/mood_entries/{entryId} {
      allow read: if isSignedIn() && (uid() == userId || isApprovedDoctorForPatient(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/vitals_records/{recordId} {
      allow read: if isSignedIn() && (uid() == userId || isApprovedDoctorForPatient(userId));
      allow write: if isSignedIn() && uid() == userId;
    }

    match /Users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() &&
        (resource.data.doctorId == uid() || resource.data.patientId == uid());
      allow create: if isSignedIn() && request.resource.data.doctorId == uid();
      allow update: if isSignedIn() &&
        (resource.data.doctorId == uid() || resource.data.patientId == uid());
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid() == doctorId;
    }

    // ─── Patients (manual creation by doctors) ─────────────────────────────────
    // Doctors may create manual patient records that are linked to them.
    // Patients themselves (mobile app) should use the legacy `Users/{uid}` docs.
    match /patients/{patientId} {
      allow create: if isSignedIn()
        && request.resource.data.isManual == true
        && request.resource.data.assignedDoctorId == uid();
      // Doctors can read/update patient docs only if linked to them
      allow read, update: if isSignedIn()
        && resource.data.assignedDoctorId == uid();
      // Allow doctors to delete ONLY manual patients they created
      allow delete: if isSignedIn()
        && resource.data.assignedDoctorId == uid()
        && resource.data.isManual == true;
    }

    // ─── Referrals / invitations (doctor-owned) ────────────────────────────────
    // Used to generate a signup link and to log invitation attempts.
    match /referrals/{doctorId} {
      allow read, write: if isSignedIn() && uid() == doctorId;

      match /invitations/{invitationId} {
        allow read, write: if isSignedIn() && uid() == doctorId;
      }
    }

    // ─── Email queue (Firebase Extension: Trigger Email) ───────────────────────
    // Allow signed-in users to enqueue emails, but never read/update them.
    // This enables client-side email sends without Cloud Functions.
    match /mail/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] is string
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasAny(['html', 'text'])
        && request.resource.data.message.subject is string;
      allow read, update, delete: if false;
    }

    // Some projects configure Trigger Email to use `emails` instead of `mail`.
    match /emails/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && request.resource.data.to[0] is string
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasAny(['html', 'text'])
        && request.resource.data.message.subject is string;
      allow read, update, delete: if false;
    }

    // ─── Practices ──────────────────────────────────────────────────────────────

    match /practices/{practiceId} {
      // Any signed-in member may read practice context
      allow read: if isSignedIn() && isMember(practiceId);
      // Only owners can create or update practice metadata
      allow create: if isSignedIn();   // owner auto-provisioned on first login
      allow update: if isSignedIn() && isOwner(practiceId);

      // ─── Members ──────────────────────────────────────────────────────────────

      match /members/{memberId} {
        // Members can read their own record; owners can read all
        allow read: if isSignedIn() &&
          (uid() == memberId || isOwner(practiceId));
        // Owner bootstrap: allow creating your own owner membership on your own practice
        allow create: if isSignedIn() && (
          isOwner(practiceId) ||
          (
            uid() == memberId &&
            get(/databases/$(database)/documents/practices/$(practiceId)).data.ownerId == uid() &&
            request.resource.data.role == 'owner'
          )
        );
        // Only owners can update/delete member permissions and role assignments
        allow update, delete: if isSignedIn() && isOwner(practiceId);
      }

      // ─── Bookable Blocks ───────────────────────────────────────────────────────
      // Patients NEVER read bookable block documents directly.
      // Slot availability is served as derived AvailableSlot objects.

      match /bookableBlocks/{blockId} {
        allow read: if isSignedIn() && isMember(practiceId);
        allow create, update, delete: if isSignedIn() &&
          hasPerm(practiceId, 'manageAppointments');
      }

      // ─── Soft Blocks ───────────────────────────────────────────────────────────
      // Strictly doctor/practice only. Patients can NEVER access.

      match /softBlocks/{softBlockId} {
        allow read: if isSignedIn() &&
          isMember(practiceId) && hasPerm(practiceId, 'manageSoftBlocks');
        allow create, update: if isSignedIn() &&
          hasPerm(practiceId, 'manageSoftBlocks');
        allow delete: if isSignedIn() &&
          hasPerm(practiceId, 'manageSoftBlocks');
      }

      // ─── Practice Appointments ─────────────────────────────────────────────────

      match /appointments/{appointmentId} {
        allow read: if isSignedIn() &&
          (isMember(practiceId) ||
           resource.data.patientId == uid());

        allow create: if isSignedIn() &&
          hasPerm(practiceId, 'manageAppointments') &&
          // Patients cannot set overrideApplied = true
          (!request.resource.data.keys().hasAny(['overrideApplied']) ||
            request.resource.data.overrideApplied == false ||
            hasPerm(practiceId, 'overrideConflicts'));

        allow update: if isSignedIn() && (
          // Practice members with permission can update
          hasPerm(practiceId, 'manageAppointments') ||
          // Patients may only update their own appointment status (cancellation)
          (resource.data.patientId == uid() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
        ) && (
          // Only permissioned members may set overrideApplied = true
          !request.resource.data.keys().hasAny(['overrideApplied']) ||
          request.resource.data.overrideApplied == resource.data.overrideApplied ||
          hasPerm(practiceId, 'overrideConflicts')
        );
      }

      // ─── Booking Policy ────────────────────────────────────────────────────────

      match /config/bookingPolicy {
        allow read: if isSignedIn() && isMember(practiceId);
        allow write: if isSignedIn() &&
          hasPerm(practiceId, 'editBookingPolicies');
      }

      // ─── Daily Schedule ────────────────────────────────────────────────────────

      match /dailySchedule/{dateId} {
        allow read: if isSignedIn() && isMember(practiceId);
        allow write: if isSignedIn() && isMember(practiceId);
      }
    }
  }
}
